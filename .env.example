# Garmin Connect Personal API key.
# Create one at https://connect.garmin.com/app/settings/personalApiToken
# (shown only once). Copy this file to .env and paste the key below.
GARMIN_PERSONAL_API_KEY=

# Optional overrides (defaults shown).
# GARMIN_PERSONAL_API_BASE_URL=https://personal.connectapi.garmin.com
# GARMIN_TOKEN_FILE=.garmin_token.json
