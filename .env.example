# Garmin Connect Developer Program — OAuth2 (PKCE) app credentials.
# Copy this file to .env and fill in the values from the developer portal.
GARMIN_CLIENT_ID=
GARMIN_CLIENT_SECRET=

# Must exactly match a redirect URL registered for your app in the portal.
GARMIN_REDIRECT_URI=http://localhost:8080/callback

# Optional overrides (defaults shown).
# GARMIN_AUTH_URL=https://connect.garmin.com/oauth2Confirm
# GARMIN_TOKEN_URL=https://diauth.garmin.com/di-oauth2-service/oauth/token
# GARMIN_API_BASE=https://apis.garmin.com
# GARMIN_TOKEN_FILE=.garmin_tokens.json
